---
import { marked } from 'marked';
import Button from './Button.astro';
import siteConfig from '../data/site-config';

const hero = siteConfig.hero;
---

<section class="w-full flex flex-col gap-8 mb-16 sm:mb-24 min-h-[240px]">
    <h1 class="text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">
        Hi There!<span class="animate-blink text-orange-500 selection:text-white">_</span>
    </h1>
    <div class="max-w-none prose prose-theme sm:prose-lg">
        I'm **Raditya Harya**, a software engineer from Indonesia. I am passionate about web development, design, and technology. I write about web development,
        automation, and other tech-related topics.
    </div>
    {
        hero?.actions && hero.actions.length > 0 && (
            <div class="flex flex-wrap gap-4">
                {hero.actions.map((action) => (
                    <Button href={action.href}>{action.text}</Button>
                ))}
            </div>
        )
    }
</section>
