---
import { type Project } from '../data/projectsData';
import { Icon } from 'astro-icon/components';

export type Props = {
    project: Project;
    class?: string;
};

const languageColors = {
    TypeScript: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
    JavaScript: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200',
    HTML: 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200',
    CSS: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200',
    Python: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
    Shell: 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200',
    Astro: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200',
    PHP: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200',
    Lua: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
    Markdown: 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200',
    YAML: 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200',
    JSON: 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200',
    Dockerfile: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
    PowerShell: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200'
};

const {
    project: { title, description, href, topics, language, fork, fork_parent, languages, stargazers_count, archived },
    class: className
} = Astro.props;
---

<a class:list={['flex justify-between items-start gap-8 group', className]} href={href} target="_blank" rel="noopener noreferrer">
    <div class="grow">
        <div class="flex items-center gap-2">
            <h2
                class="text-xl leading-tight font-medium group-hover:underline group-hover:decoration-dashed group-hover:underline-offset-4 group-hover:decoration-1 sm:text-2xl flex items-center gap-2"
            >
                {title}
            </h2>
            <!-- {
              stargazers_count > 0 && (
                  <span class="px-2 py-0.5 text-xs rounded-full bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200">
                      ★ {stargazers_count}
                  </span>
              )
          } -->
            <Icon name="new-tab" class="w-4 h-4 group-hover:opacity-100 opacity-0" />
        </div>

        <div class="mt-1 text-sm leading-normal">
            <p class="mt-1 text-sm leading-normal">
                <!-- {
                    archived && (
                        <span class="px-2 py-0.5 text-xs text-yellow-800  dark:text-yellow-200 border border-yellow-800 dark:border-yellow-200">Archived</span>
                    )
                } -->
                {description}
            </p>
        </div>

        {
            fork && fork_parent && (
                <div class="mt-1 text-xs">
                    Forked from <span class="underline">{fork_parent.replace('https://github.com/', '')}</span>
                </div>
            )
        }

        <div class="mt-3 flex flex-wrap gap-2">
            {languages?.map((lang) => <span class:list={['px-2 py-0.5 text-xs', languageColors[lang as keyof typeof languageColors]]}>{lang}</span>)}
            {topics.map((topic) => <span class="px-2 py-0.5 text-xs bg-muted">{topic}</span>)}
        </div>
    </div>
</a>
