---
export type PostHeaderProps = {
    title: string;
    publishDate: string;
    updatedDate?: string;
    excerpt?: string;
};

import FormattedDate from './FormattedDate.astro';

const { title, publishDate, updatedDate } = Astro.props;
---

<header class="flex flex-col sm:flex-row w-full border-2 border-foreground mb-8">
    <div class="flex flex-col w-full sm:w-2/3 sm:border-r-2 border-foreground">
        <div class="flex flex-col justify-center p-3 sm:py-3 py-6">
            <h1 class="text-2xl sm:text-3xl font-semibold">{title}</h1>
        </div>
        <div class="flex border-t-2 border-foreground text-sm">
            <dt class="p-3 font-bold">Author</dt>
            <dd class="p-3 border-l-2 border-foreground">Raditya Harya</dd>
        </div>
    </div>

    <aside class="grid grid-cols-1 sm:w-1/3 text-sm" aria-label="Article metadata">
        <dl class="flex p-3 border-t-2 sm:border-t-0 border-foreground">
            <dt class="font-bold mr-1">Version:</dt>
            <dd>v1.0.0</dd>
        </dl>
        <dl class="flex p-3 border-t-2 border-foreground">
            <dt class="font-bold mr-1">{updatedDate ? 'Updated' : 'Published'}:</dt>
            <dd><FormattedDate date={updatedDate ?? publishDate} /></dd>
        </dl>
        <dl class="flex p-3 border-t-2 border-foreground">
            <dt class="font-bold mr-1">License:</dt>
            <dd>CC-BY-4.0</dd>
        </dl>
    </aside>
</header>
