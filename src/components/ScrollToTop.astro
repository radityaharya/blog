<button
    id="scroll-to-top"
    class="fixed bottom-8 right-8 text-main opacity-0 transition-opacity duration-200 hover:bg-main/5 size-8 hidden md:flex items-center justify-center text-lg"
    aria-label="Scroll to top"
>
    <svg
        width="24"
        height="24"
        xmlns="http://www.w3.org/2000/svg"
        fill-rule="evenodd"
        clip-rule="evenodd"
        fill="currentColor"
        class="w-6 h-6"
        viewBox="0 0 24 24"><path d="M11 2.206l-6.235 7.528-.765-.645 7.521-9 7.479 9-.764.646-6.236-7.53v21.884h-1v-21.883z"></path></svg
    >
</button>

<script>
    document.addEventListener('astro:page-load', () => {
        const scrollButton = document.getElementById('scroll-to-top');

        const toggleScrollButton = () => {
            if (!scrollButton) return;
            scrollButton.style.opacity = window.scrollY > 200 ? '1' : '0';
        };

        scrollButton?.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        document.addEventListener('scroll', toggleScrollButton);
    });
</script>
