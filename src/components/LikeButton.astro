---
interface Props {
    slug: string;
    class?: string;
}

const { slug, class: className } = Astro.props;
---

<button class:list={['inline-flex items-center gap-2 text-sm text-foreground', className]} id="like-btn">
    <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        id="like-icon"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-4 h-4"
        ><path
            d="m12 21.35l-1.45-1.32C5.4 15.36 2 12.27 2 8.5C2 5.41 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.08C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.41 22 8.5c0 3.77-3.4 6.86-8.55 11.53z"
        ></path></svg
    >
</button>

<script>
    import { actions } from 'astro:actions';

    const updateLikeIcon = (isLiked = false) => {
        const likeIcon = document.getElementById('like-icon');
        if (likeIcon) {
            likeIcon.setAttribute('fill', isLiked ? 'currentColor' : 'none');
        }
    };

    const handleLikeButtonClick = async (slug: string , key: string) => {
        // if (localStorage.getItem('likes:' + slug) === 'true') {
        //     return;
        // }

        const { data, error } = await actions.likePage({ slug: key });
        if (!error) {
            const count = document.getElementById('like-count');
            if (count) {
                count.textContent = data.likes + ' like' + (data.likes === 1 ? '' : 's');
            }
            localStorage.setItem(key, 'true');
            updateLikeIcon(true);
        }
    };

    const handlePageLoad = () => {
        const pathSegments = window.location.pathname.split('/').filter(Boolean);
        const slug = pathSegments.length > 1 && pathSegments[0] === 'blog' ? pathSegments[1] : '';
        const key = 'likes:' + slug;
        const isLiked = localStorage.getItem(key) === 'true';

        updateLikeIcon(isLiked);

        const button = document.getElementById('like-btn');
        if (button) {
            button.removeEventListener('click', () => {});
            button.addEventListener('click', () => handleLikeButtonClick(slug, key));
        }
    };

    document.addEventListener('astro:page-load', handlePageLoad);
    document.addEventListener('astro:after-swap', handlePageLoad);
    document.addEventListener('astro:after-preparation', handlePageLoad);
</script>
