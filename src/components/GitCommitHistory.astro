---
import { getDailyCommits } from '../data/commitStats';

const username = 'radityaharya';
const dailyCommits = await getDailyCommits(username, Astro.locals.runtime.env);

// Get dates for the last 30 days
const dates = Array.from({ length: 30 }, (_, i) => {
    const date = new Date();
    date.setDate(date.getDate() - i);
    return date;
});

const commitData = dates
    .map((date, index) => ({
        date,
        count: dailyCommits[index] || 0
    }))
    .filter((item) => item.count > 0);
---

<style>
    .commit-history {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .day-entry {
        padding: 0.5rem;
        border: 1px solid rgba(var(--color-text-main), 0.1);
        border-radius: 4px;
        background: rgba(var(--color-text-main), 0.05);
    }
</style>

<div class="w-full max-w-2xl">
    <h3 class="font-bold text-xl mb-4">Contribution Activity</h3>
    <div class="space-y-2">
        {
            commitData.map(({ date, count }) => (
                <div class="flex items-center gap-4 p-3 rounded-lg bg-gray-50 dark:bg-gray-800/50">
                    <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
                            <path d="M1.5 8a6.5 6.5 0 1113 0 6.5 6.5 0 01-13 0zM8 0a8 8 0 100 16A8 8 0 008 0zm.5 4.75a.75.75 0 00-1.5 0v3.5a.75.75 0 00.471.696l2.5 1a.75.75 0 00.557-1.392L8.5 7.742V4.75z" />
                        </svg>
                    </div>
                    <div class="flex-1">
                        <div class="font-medium">
                            {count} contribution{count > 1 ? 's' : ''}
                        </div>
                        <div class="text-sm text-gray-600 dark:text-gray-400">
                            {date.toLocaleDateString('en-US', {
                                weekday: 'long',
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric'
                            })}
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</div>
