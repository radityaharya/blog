---
interface SpotifyResponse {
    item: {
        name: string;
        artists: Array<{ name: string }>;
        album: {
            images: Array<{ url: string }>;
        };
        external_urls: {
            spotify: string;
        };
    };
    is_playing: boolean;
}

let track;
let isPlaying = false;
let trackUrl = '';
let artistName = '';
let trackName = '';

try {
    const response = await fetch('https://nowplaying.radityaharya.workers.dev/now-playing');
    const data: SpotifyResponse = await response.json();

    if (data && data.item) {
        track = data.item;
        isPlaying = data.is_playing;
        trackUrl = track.external_urls.spotify;

        const truncate = (str: string, length: number) => {
            return str.length > length ? str.substring(0, length) + '...' : str;
        };

        artistName = truncate(track.artists[0].name, 15);
        trackName = truncate(track.name, 10);
    }
} catch (error) {
    console.error('Failed to fetch Spotify data:', error);
}
---

{
    track ? (
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-1 sm:gap-2 w-full">
            <p class="text-sm whitespace-normal">{isPlaying ? "I'm currently listening to" : 'I last listened to'}</p>
            <div class="text-sm flex flex-wrap gap-1">
                <a href={trackUrl} target="_blank" class="inline-flex items-center gap-1 hover:underline">
                    <span class="bg-muted px-1">{trackName}</span>
                    <span>by</span>
                    <span class="bg-muted px-1">{artistName}</span>
                </a>
            </div>
        </div>
    ) : null
}
