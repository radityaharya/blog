---
export type PostHeaderProps = {
    title: string;
    publishDate: string;
    updatedDate?: string;
    excerpt?: string;
};

import FormattedDate from './FormattedDate.astro';

const { title, publishDate, updatedDate, excerpt } = Astro.props;
---

<header class="mb-8">
    <h1 class="text-4xl leading-tight font-bold  sm:leading-tight">{title}</h1>
    <div class="mt-4 text-sm">
        <FormattedDate date={publishDate} />
        {
            updatedDate && (
                <>
                    {' '}
                    <span>
                        (Updated on <FormattedDate date={updatedDate} />)
                    </span>
                </>
            )
        }
    </div>
</header>
