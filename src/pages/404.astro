---
import BaseLayout from '../layouts/BaseLayout.astro';

// TODO: https://github.com/withastro/astro/issues/12771
// Server Islands are broken when using prerendered 404 pages
export const prerender = true;
---

<BaseLayout title="404: Not Found" description="Page not found" showHeader={false}>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">404: Page Not Found</h1>
        </header>
        <div class="max-w-none prose prose-theme sm:prose-lg">
            <p>The page you're looking for doesn't exist or has been moved.</p>
            <p><a href="/">Return to homepage</a></p>
        </div>
    </article>
</BaseLayout>
