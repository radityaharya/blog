---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import PostPreview from '../../components/PostPreview.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';
import { idify } from '../../utils/common-utils';
import ScrollToTop from '../../components/ScrollToTop.astro';
import { getEntry, render } from 'astro:content';
import PostHeader from '../../components/PostHeader.astro';
import PostHeaderAlt from '../../components/PostHeaderAlt.astro';
import ViewCounter from '../../components/ViewCounter.astro';
import LikeButton from '../../components/LikeButton.astro';
import LikeButtonFallback from '../../components/LikeButtonFallback.astro';
// import Tldr from '../../components/Tldr.astro';

export async function getStaticPaths() {
    const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
    const postCount = posts.length;
    return posts.map((post: { id: any }, index: number) => ({
        params: { id: post.id },
        props: {
            post,
            prevPost: index + 1 !== postCount ? posts[index + 1] : null,
            nextPost: index !== 0 ? posts[index - 1] : null
        }
    }));
}

type Props = { post: CollectionEntry<'blog'>; prevPost: CollectionEntry<'blog'>; nextPost: CollectionEntry<'blog'> };

const { href } = Astro.url;
const { post, prevPost, nextPost } = Astro.props;
const { title, publishDate, updatedDate, excerpt, tags = [], seo } = post.data;
const { Content } = await render(post);

export const prerender = true;
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? excerpt} image={seo?.image} pageType="article" showHeader={false}>
    <article class="mb-16 sm:mb-24">
        <PostHeaderAlt title={title} publishDate={publishDate} updatedDate={updatedDate} excerpt={excerpt} />
        <!-- <Tldr pageId={post.id}/> -->
        <div class="max-w-none prose prose-theme sm:prose-lg">
            <Content />
        </div>
        <div class="flex flex-row gap-3 mt-8 sm:mt-12">
            <ViewCounter slug={post.id} server:defer />
            <LikeButton slug={post.id} server:defer>
                <LikeButtonFallback slug={post.id} slot="fallback" />
            </LikeButton>
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-6 text-sm justify-between sm:text-base select-none">
            {
                tags.length > 0 && (
                    <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
                        {tags.map((tag: string) => (
                            <a class="text-main hover:underline" href={`/tags/${idify(tag)}`}>
                                #{tag}
                            </a>
                        ))}
                    </div>
                )
            }
            <Button class="copy-url-button" aria-label="Copy link" data-url={href} data-tooltip-default="Copy link" data-tooltip-success="Copied">Share</Button>
        </div>
    </article>
    {
        (prevPost || nextPost) && (
            <div class="my-16 sm:my-24">
                <h2 class="mb-12 text-xl sm:mb-16 sm:text-2xl">Read Next</h2>
                {nextPost && <PostPreview post={nextPost} class="mb-10 sm:mb-12" headingLevel="h3" />}
                {prevPost && <PostPreview post={prevPost} class="mb-10 sm:mb-12" headingLevel="h3" />}
            </div>
        )
    }
    <ScrollToTop />
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const copyUrlButton = document.querySelector('.copy-url-button') as HTMLButtonElement;
        copyUrlButton?.addEventListener('click', async () => {
            await copyUrl(copyUrlButton);
        });

        async function copyUrl(button: HTMLButtonElement) {
            let url = button.getAttribute('data-url') || '';
            let label = button.innerText;

            await navigator.clipboard.writeText(url);

            button.innerText = 'Copied';

            setTimeout(() => {
                button.innerText = label;
            }, 2500);
        }
    });
</script>
