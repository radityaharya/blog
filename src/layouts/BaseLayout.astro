---
import '@fontsource/geist-mono/500.css';
import { ClientRouter } from 'astro:transitions';
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';

export type Props = HeadProps & { showHeader?: boolean };

const { showHeader = true, ...head } = Astro.props;
---

<!doctype html>
<html lang="en" class="antialiased break-words selection:bg-orange-400/50 dark">
    <head>
        <script is:inline>
            (function () {
                const theme = localStorage.theme === 'light' ? 'light' : 'dark';
                document.documentElement.className = theme;
                document.documentElement.style.colorScheme = theme;
            })();
        </script>
        <style is:inline>
            /* Prevent FOUC */
            html.dark {
                background: #0a0a0a;
                color: #f2f1ec;
            }
        </style>
        <BaseHead {...head} />
        <ClientRouter />
    </head>
    <body class="bg-main text-main font-mono">
        <div class="flex flex-col min-h-screen px-4 md:px-8">
            <Nav />
            {showHeader && <Header />}
            <main class="grow w-full max-w-3xl mx-auto" transition:animate="none">
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>
